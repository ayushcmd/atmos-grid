# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Data files (too large for git)
data/raw/*
!data/raw/.gitkeep
data/processed/*_raw_*.csv
models/*.ubj
!models/aqi_xgboost.pkl
!models/.gitkeep

# Outputs (allow lightweight deployment artifacts for Cloud deployment)
outputs/predictions/*
outputs/hotspots/*
outputs/metrics/*
!outputs/predictions/.gitkeep
!outputs/hotspots/.gitkeep
!outputs/metrics/.gitkeep
!outputs/predictions/aqi_test_predictions.csv
!outputs/hotspots/hcho_hotspots.geojson
!outputs/hotspots/hcho_clusters_summary.csv
!outputs/metrics/*.json
!outputs/metrics/*.csv

# Credentials and secrets
.env
.cdsapirc
*.key
credentials/

